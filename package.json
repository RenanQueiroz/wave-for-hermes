{
  "name": "wave",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@rnrepo/expo-config-plugin": "^0.3.5",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "panelui-native": "^0.30.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-mcp": "~0.2.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "android": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start --android",
    "ios": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start --ios",
    "lint": "expo lint",
    "test": "npm run test:hermes",
    "test:hermes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/services/hermes/hermes-sse.test.ts src/services/hermes/hermes-client.test.ts",
    "test:hermes:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/hermes-integration.ts",
    "mobile:build": "npm --prefix tools/mobile-agent run build",
    "mobile:check": "npm --prefix tools/mobile-agent run check",
    "mobile:doctor": "npm --prefix tools/mobile-agent run doctor",
    "mobile:install": "npm --prefix tools/mobile-agent install",
    "mobile:mcp": "npm --prefix tools/mobile-agent run mcp",
    "mobile:prepare:ios": "npm --prefix tools/mobile-agent run prepare:ios",
    "mobile:prune:artifacts": "npm --prefix tools/mobile-agent run prune:artifacts --",
    "mobile:reload": "npm --prefix tools/mobile-agent run reload --",
    "mobile:smoke:android": "npm --prefix tools/mobile-agent run smoke:android --",
    "mobile:smoke:observability": "npm --prefix tools/mobile-agent run smoke:observability --",
    "mobile:smoke:ios": "npm --prefix tools/mobile-agent run smoke:ios --",
    "mobile:smoke:production": "npm --prefix tools/mobile-agent run smoke:production --"
  },
  "private": true
}
