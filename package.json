{
  "name": "wave",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@legendapp/list": "3.3.3",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@wave/contracts": "0.1.0",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "panelui-native": "^0.49.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-audio-api": "0.13.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-keyboard-controller": "1.22.2",
    "react-native-legal": "^1.6.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "expo-mcp": "~0.2.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-keyboard-controller"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "android": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start --android",
    "ios": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start --ios",
    "build:contracts": "npm run build --workspace @wave/contracts",
    "build:preview:android:local": "npx --yes eas-cli@21.4.0 build --platform android --profile preview --local --output ./artifacts/wave-preview.apk",
    "build:production:android:local": "npx --yes eas-cli@21.4.0 build --platform android --profile production --local --output ./artifacts/wave-production.aab",
    "build:production:ios:local": "npx --yes eas-cli@21.4.0 build --platform ios --profile production --local --output ./artifacts/wave-production.ipa",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "expo lint && npm run lint --workspace @wave/contracts && npm run format:check",
    "test": "npm run test:mobile && npm run test --workspace @wave/contracts",
    "test:mobile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./test/mobile/register-expo-fetch-loader.mjs --test test/mobile/*.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @wave/contracts",
    "verify:boundaries": "node scripts/verify-workspace-boundaries.mjs",
    "mobile:build": "npm --prefix tools/mobile-agent run build",
    "mobile:check": "npm --prefix tools/mobile-agent run check",
    "mobile:doctor": "npm --prefix tools/mobile-agent run doctor",
    "mobile:install": "npm --prefix tools/mobile-agent install",
    "mobile:mcp": "npm --prefix tools/mobile-agent run mcp",
    "mobile:prepare:ios": "npm --prefix tools/mobile-agent run prepare:ios",
    "mobile:prune:artifacts": "npm --prefix tools/mobile-agent run prune:artifacts --",
    "mobile:reload": "npm --prefix tools/mobile-agent run reload --",
    "mobile:smoke:android": "npm --prefix tools/mobile-agent run smoke:android --",
    "mobile:smoke:observability": "npm --prefix tools/mobile-agent run smoke:observability --",
    "mobile:smoke:ios": "npm --prefix tools/mobile-agent run smoke:ios --",
    "mobile:smoke:production": "npm --prefix tools/mobile-agent run smoke:production --"
  },
  "private": true
}
