{
  "name": "@wave/companion",
  "version": "0.1.0",
  "description": "Trusted server-side boundary between Wave mobile, Hermes, and OpenAI Realtime",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "admin": "node --experimental-strip-types scripts/admin.ts",
    "build": "npm run build --workspace @wave/contracts && tsc -p tsconfig.build.json",
    "dev": "npm run build --workspace @wave/contracts && node --experimental-strip-types --watch src/server.ts",
    "integration:hermes": "node --experimental-strip-types scripts/hermes-integration.ts",
    "lint": "eslint src test scripts --max-warnings=0",
    "mobile-fixture": "npm run build --workspace @wave/contracts && node --experimental-strip-types scripts/mobile-fixture.ts",
    "start": "node dist/server.js",
    "test": "npm run build --workspace @wave/contracts && node --experimental-strip-types --test src/auth/sqlite-device-store.test.ts src/chat/active-turns.test.ts src/hermes/hermes-sse.test.ts src/hermes/hermes-client.test.ts test/config.test.ts test/server.test.ts test/wave-api.test.ts",
    "test:hermes": "node --experimental-strip-types --test src/hermes/hermes-sse.test.ts src/hermes/hermes-client.test.ts",
    "typecheck": "npm run build --workspace @wave/contracts && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@wave/contracts": "0.1.0",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
